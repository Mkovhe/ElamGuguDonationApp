<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:ElamIguguLeli.App.Pages"
       x:Class="ElamIguguLeli.App.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.BackgroundColor="{StaticResource Brand}"
       Shell.TitleColor="White"
       Shell.ForegroundColor="White"
       Title="Elam Igugu Leli">

    <ShellContent Title="Welcome" ContentTemplate="{DataTemplate pages:LandingPage}" Route="landing" />
    <ShellContent Title="Sign in" ContentTemplate="{DataTemplate pages:LoginPage}" Route="login" />
    <ShellContent Title="Home" ContentTemplate="{DataTemplate pages:HomePage}" Route="home" />
</Shell>
