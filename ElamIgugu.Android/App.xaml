<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ElamIguguLeli.App"
             x:Class="ElamIguguLeli.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="Brand">#237A3B</Color>
            <Color x:Key="BrandDark">#174D2A</Color>
            <Color x:Key="Cream">#FBF7EE</Color>
            <Color x:Key="AccentSoft">#EAF6DA</Color>
            <Color x:Key="BrandLight">#E6F1E6</Color>
            <Color x:Key="Accent">#93D768</Color>
            <Color x:Key="Ink">#1B2A1C</Color>
            <Color x:Key="Muted">#5B6B5C</Color>
            <Color x:Key="ErrorText">#B00020</Color>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource BrandDark}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Brand}" />
                <Setter Property="BorderColor" Value="{StaticResource Brand}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>
            <Style x:Key="GoldButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                <Setter Property="TextColor" Value="#17340F" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="HeightRequest" Value="56" />
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="#DFE6D6" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
