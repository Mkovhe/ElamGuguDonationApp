<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ElamIguguLeli.App.Pages.LoginPage"
             Title="Sign in">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Border StrokeThickness="0" Padding="20" BackgroundColor="{StaticResource BrandDark}">
                <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Elam Igugu Leli" FontSize="26" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                    <Label Text="Welcome back" TextColor="{StaticResource Accent}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Entry x:Name="EmailEntry" Placeholder="Email address" Keyboard="Email" ReturnType="Next" />
            <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" ReturnType="Done" Completed="OnLoginClicked" />
            <Entry x:Name="CodeEntry" Placeholder="6-digit authenticator code" Keyboard="Numeric" MaxLength="7" IsVisible="False" />

            <Label x:Name="ErrorLabel" TextColor="{StaticResource ErrorText}" IsVisible="False" />

            <Button x:Name="LoginButton" Text="Sign in" Style="{StaticResource PrimaryButton}" Clicked="OnLoginClicked" />
            <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" Color="{StaticResource Brand}" />

            <Button Text="New here? Sign up" Style="{StaticResource SecondaryButton}" Clicked="OnRegisterClicked" />
            <Button Text="View webinars" Style="{StaticResource SecondaryButton}" Clicked="OnWebinarsClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
