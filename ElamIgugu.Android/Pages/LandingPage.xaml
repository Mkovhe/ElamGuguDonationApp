<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ElamIguguLeli.App.Pages.LandingPage"
             Title="Elam Igugu Leli">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="Elam Igugu Leli" FontSize="30" FontAttributes="Bold"
                   TextColor="{StaticResource Brand}" HorizontalOptions="Center" />
            <Label Text="Give something to those who have nothing." FontSize="22" FontAttributes="Bold"
                   TextColor="{StaticResource Ink}" HorizontalTextAlignment="Center" />
            <Label Text="Sowing Hope, Change and Greening Futures" TextColor="{StaticResource Muted}"
                   HorizontalTextAlignment="Center" />

            <Button Text="Sign up to donate" Style="{StaticResource PrimaryButton}" Clicked="OnSignUpClicked" />
            <Button Text="Sign in" Style="{StaticResource SecondaryButton}" Clicked="OnSignInClicked" />
            <Button Text="View webinars" Style="{StaticResource SecondaryButton}" Clicked="OnWebinarsClicked" />

            <Label Text="REF: 260-053 NPO" TextColor="{StaticResource Muted}" FontSize="12" HorizontalTextAlignment="Center" />

            <Border BackgroundColor="{StaticResource BrandLight}" StrokeThickness="0" Padding="16">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="What we collect" FontAttributes="Bold" TextColor="{StaticResource Ink}" />
                    <Label Text="Clothes, non-perishable food, money (EFT)" TextColor="{StaticResource Ink}" />
                    <Label Text="Drop-off" FontAttributes="Bold" TextColor="{StaticResource Ink}" Margin="0,8,0,0" />
                    <Label Text="12 Susan Road, Amalinda, Haven Hills" TextColor="{StaticResource Ink}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
