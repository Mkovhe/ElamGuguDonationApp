<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ElamIguguLeli.App.Pages.LandingPage"
             Title="Elam Igugu Leli">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Image Source="elam_logo.png" Aspect="AspectFit" HeightRequest="220" HorizontalOptions="Center" />

            <Label Text="Give something to those who have nothing." FontSize="26" FontAttributes="Bold"
                   TextColor="{StaticResource BrandDark}" HorizontalTextAlignment="Center" />

            <Button Text="Sign up to donate" Style="{StaticResource GoldButton}" Margin="0,8,0,0" Clicked="OnSignUpClicked" />
            <Button Text="Sign in" Style="{StaticResource SecondaryButton}" Clicked="OnSignInClicked" />
            <Button Text="About us" BackgroundColor="Transparent" TextColor="{StaticResource Brand}" Clicked="OnAboutClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
