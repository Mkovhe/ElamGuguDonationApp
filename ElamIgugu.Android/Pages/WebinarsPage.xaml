<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             xmlns:models="clr-namespace:ElamIguguLeli.App.Models"
             x:Class="ElamIguguLeli.App.Pages.WebinarsPage"
             Title="Career day webinars">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="8">
        <Border Grid.Row="0" StrokeThickness="0" Padding="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#174D2A" Offset="0.0" />
                    <GradientStop Color="#2E8B45" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <shapes:Ellipse Fill="#2693D768" WidthRequest="130" HeightRequest="130" HorizontalOptions="End" VerticalOptions="Start" Margin="0,0,0,0" />
                <shapes:Ellipse Fill="#1FFFFFFF" WidthRequest="70" HeightRequest="70" HorizontalOptions="Start" VerticalOptions="End" Margin="0,0,0,0" />
                <VerticalStackLayout Padding="18" Spacing="10">
                    <Label Text="Career day webinars" FontSize="24" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Free sessions for young people. No account needed." TextColor="#DDF3C4" />
                </VerticalStackLayout>
            </Grid>
        </Border>
        <ActivityIndicator x:Name="Busy" Grid.Row="1" IsRunning="True" IsVisible="True" Color="{StaticResource Brand}" />

        <CollectionView x:Name="WebinarList" Grid.Row="2">
            <CollectionView.EmptyView>
                <Label Text="There are no upcoming webinars right now. Please check back soon."
                       HorizontalTextAlignment="Center" Margin="0,24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ApiWebinar">
                    <Border Style="{StaticResource CardBorder}" Margin="0,6">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Topic}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource BrandDark}" />
                            <Label Text="{Binding SpeakerText}" />
                            <Label Text="{Binding WhenText}" />
                            <Button Text="Register" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"
                                    CommandParameter="{Binding Id}" Clicked="OnRegisterClicked" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
