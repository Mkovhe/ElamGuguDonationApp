@inject IOptions<NpoOptions> Npo
@{
    ViewData["Title"] = "Welcome";
}

<section class="hero my-3">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <p class="eyebrow">Your little input can make a difference</p>
            <h1 class="hero-title">Give something to those who have nothing.</h1>
            <p class="lead text-muted">
                Donate clothes, food or money to children and young people in
                PE, Alice, East London and Johannesburg.
            </p>
            <div class="d-flex flex-wrap gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn-gold btn-lg" asp-controller="Home" asp-action="Dashboard">Go to my page</a>
                }
                else
                {
                    <a class="btn btn-gold btn-lg" asp-controller="Account" asp-action="Register">Sign up to donate</a>
                    <a class="btn btn-outline-secondary btn-lg" asp-controller="Account" asp-action="Login">Sign in</a>
                }
            </div>
            <p class="mt-4 mb-0"><a class="hero-link" asp-controller="Home" asp-action="About">How it works</a></p>
        </div>
        <div class="col-lg-5">
            <img class="hero-logo" src="~/images/elam_logo.png" alt="Elam Igugu Leli: your little input can make a difference" />
        </div>
    </div>
</section>
