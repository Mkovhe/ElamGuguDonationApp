@model ErrorInfo
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="auth-card text-center">
    <h1 class="page-title">Something went wrong</h1>
    <p class="text-muted">Sorry, we could not complete that. Please try again, or go back to the home page.</p>
    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-brand" asp-controller="Home" asp-action="Index">Back to home</a>
</div>
