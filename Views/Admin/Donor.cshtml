@model DonorDetailViewModel
@{
    ViewData["Title"] = Model.FullName;
}

<p class="mb-2"><a asp-action="Index" asp-route-tab="donors">&larr; Back to donors list</a></p>
<h1 class="page-title mb-1">@Model.FullName</h1>
<p class="text-muted">
    @Model.ContactNumber &middot; @Model.Email &middot; Joined @SaTime.Format(Model.CreatedDate)
</p>

<h2 class="section-title">Donations</h2>
<div class="table-wrap">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th scope="col">Date</th>
                <th scope="col">Items</th>
                <th scope="col">Description</th>
                <th scope="col">Status</th>
                <th scope="col">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Donations.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-4">This donor has not donated yet.</td></tr>
            }
            @foreach (var d in Model.Donations)
            {
                <tr>
                    <td>@SaTime.Format(d.DateSubmitted)</td>
                    <td>
                        @d.ItemType
                        @if (d.IsMoney)
                        {
                            <div class="small"><strong>@Rand.Format(d.Amount)</strong> &middot; Ref: <code>@d.Reference</code></div>
                        }
                    </td>
                    <td class="text-break">@(string.IsNullOrWhiteSpace(d.Description) ? "-" : d.Description)</td>
                    <td><span class="chip chip-@(d.Status == DonationStatus.Received ? "received" : "submitted")">@d.Status</span></td>
                    <td>
                        <a class="btn btn-sm @(d.Status == DonationStatus.Submitted ? "btn-brand" : "btn-outline-secondary")"
                           asp-action="Donation" asp-route-id="@d.Id">@(d.Status == DonationStatus.Submitted ? "Review" : "View")</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
