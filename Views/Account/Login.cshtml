@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-card">
    <h1 class="page-title">Sign in</h1>
    <p class="text-muted">Welcome back. Donors and admins both sign in here.</p>

    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" type="email" autocomplete="username" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-brand w-100 btn-lg">Sign in</button>
    </form>

    <p class="text-center text-muted mt-3 mb-0">
        New here? <a asp-action="Register">Create an account</a>
    </p>
</div>
