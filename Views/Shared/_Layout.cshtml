@inject IOptions<NpoOptions> Npo
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Elam Igugu Leli</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container d-flex flex-wrap align-items-center justify-content-between gap-3 py-3">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <img class="brand-logo" src="~/images/elam_logo.png" alt="" />
                <span class="brand-name">Elam Igugu Leli</span>
            </a>

            <nav class="d-flex flex-wrap align-items-center gap-2" aria-label="Main">
                <a class="nav-link-plain" asp-controller="Home" asp-action="About">About</a>
                <a class="nav-link-plain" asp-controller="Webinars" asp-action="Index">Career day webinars</a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link-plain" asp-controller="Home" asp-action="Dashboard">My page</a>
                    <span class="role-pill @(User.IsInRole(AppRoles.Admin) ? "role-admin" : "role-donor")">
                        @(User.IsInRole(AppRoles.Admin) ? "Admin" : "Donor")
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-outline-secondary">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Login">Sign in</a>
                    <a class="btn btn-brand" asp-controller="Account" asp-action="Register">Sign up</a>
                }
            </nav>
        </div>
    </header>

    <main class="container py-4">
        @if (TempData["Success"] is string successMessage)
        {
            <div class="alert alert-success" role="status">@successMessage</div>
        }
        @if (TempData["Error"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container py-3 small text-muted d-flex flex-wrap justify-content-between gap-2">
            <span>Elam Igugu Leli &middot; @Npo.Value.RegistrationNumber</span>
            <span>@Npo.Value.Slogan</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
